SKIP_KEYS = {"UBUNTU_RELEASE", "DOCKER_BASE_IMAGE", "DOCKER_USER",
             "DOCKER_WORKDIR", "OPENVINO_FULL_ID"}


def parse_versions_env(path):
    entries = []
    with open(path, "r", encoding="ascii", errors="strict") as h:
        for lineno, raw in enumerate(h, 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise ValueError("%s:%d: expected KEY=VALUE" % (path, lineno))
            k, _, v = line.partition("=")
            entries.append((k.strip(), v.strip().strip("'\"")))
    return entries


def import_versions_env(env_path):
    """Translate a versions.env file into manifest entries + notes."""
    entries = parse_versions_env(env_path)
    packages = []
    notes = []
    for key, value in entries:
        if key in SKIP_KEYS:
            notes.append("%s: metadata, not a package; skipped" % key)
            continue
        if key in KNOWN_IMPORTS:
            name, kind, provs, pkg = KNOWN_IMPORTS[key]
            op = ">=" if key.endswith("_MIN_VERSION") else "=="
            entry = {"name": name, "kind": kind, "wanted": "%s%s" % (op, value),
                     "providers": provs, "env_var": key}
            if pkg and provs == ["fetchcontent"] or kind == "sibling":
                entry["repo"] = pkg
                entry["ref"] = value
            elif pkg:
                entry["package"] = pkg
            if "custom-url" in provs and kind != "sibling":
                entry["url"] = "TODO: pin download URL for %s %s" % (name, value)
                entry["sha256"] = "TODO: 64-hex sha256"
                notes.append("%s: custom-url coordinates need pinning" % key)
            packages.append(entry)
        else:
            base = re.sub(r"(_MIN_VERSION|_REVIEWED_VERSION|_VERSION|_FULL_ID)$", "", key)
            name = base.lower().replace("_", "-")
            op = ">=" if key.endswith("_MIN_VERSION") else "=="
            packages.append({"name": name, "kind": "system-library",
                             "wanted": "%s%s" % (op, value),
                             "providers": ["apt"], "env_var": key})
            notes.append("%s: unmapped key, generic apt fallback; review" % key)
    # dedupe by name, last wins
    merged = {}
    for p in packages:
        merged[p["name"]] = p
    return {"schema_version": 1, "packages": list(merged.values())}, notes


# --- commands ------------------------------------------------------------

def cmd_validate(args):
    manifest, errs = load_manifest(args.manifest)
    if errs:
        for e in errs:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    errors = validate_manifest(manifest)
    lock, lock_errs = load_lock(args.lock)
    errors += lock_errs
    if not lock_errs:
        errors += validate_lock(lock, manifest)
    if errors:
        for e in errors:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    print("coldpac validate ok: %d packages" % len(manifest.get("packages", [])))
    return 0


def _lock_index(lock):
    idx = {}
    for r in lock.get("resolved") or []:
        if isinstance(r, dict) and r.get("name"):
            idx[r["name"]] = r
    return idx


def cmd_status(args):
    manifest, errs = load_manifest(args.manifest)
    if errs:
        for e in errs:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    errors = validate_manifest(manifest)
    lock, lock_errs = load_lock(args.lock)
    errors += lock_errs
    if not lock_errs:
        errors += validate_lock(lock, manifest)
    if errors:
        for e in errors:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    idx = _lock_index(lock)
    worst = 0  # 0 clean, 2 updates, 1 error/drift
    print("| package | wanted | locked | installed | candidate | status |")
    print("| --- | --- | --- | --- | --- | --- |")
    for p in manifest.get("packages", []):
        name = p["name"]
        wanted = p.get("wanted", "")
        locked = idx.get(name, {}).get("version", "(unlocked)")
        installed, iprov = probe_installed(p)
        candidate, _ = probe_candidate(p, args.offline)
        if installed is None:
            state = "missing"
            worst = max(worst, 1)
            inst = "(not found)"
        elif not satisfies(installed, wanted):
            state = "drift: installed %s vs wanted %s" % (installed, wanted)
            worst = max(worst, 1)
            inst = "%s (%s)" % (installed, iprov)
        elif isinstance(locked, str) and locked.startswith("("):
            state = "unlocked"
            worst = max(worst, 1)
            inst = "%s (%s)" % (installed, iprov)
        else:
            inst = "%s (%s)" % (installed, iprov)
            state = "ok"
        cand = candidate or "(unknown)"
        if candidate and installed and _dpkg_compare(candidate, "gt", installed):
            if worst == 0:
                worst = 2
            if state == "ok":
                state = "update available"
        print("| %s | `%s` | `%s` | %s | %s | %s |" %
              (name, wanted, locked, inst, cand, state))
    return worst


def cmd_check_updates(args):
    args.lock = args.lock  # same shape as status
    return cmd_status(args)


def cmd_export(args):
    lock, errs = load_lock(args.lock)
    if errs:
        for e in errs:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    if not lock.get("resolved"):
        print("ERROR: lockfile has no resolved entries: %s" % args.lock, file=sys.stderr)
        return 1
    export_versions_env(lock, args.out)
    print("coldpac export ok: %s" % args.out)
    return 0


def cmd_import(args):
    try:
        manifest, notes = import_versions_env(args.env)
    except (OSError, ValueError, UnicodeDecodeError) as e:
        print("ERROR: %s" % e, file=sys.stderr)
        return 1
    out = dump_simple_yaml(manifest) + "\n"
    if args.out:
        with open(args.out, "w", encoding="ascii", newline="\n") as h:
            h.write(out)
        print("coldpac import ok: %s" % args.out)
    else:
        sys.stdout.write(out)
    for n in notes:
        print("note: %s" % n, file=sys.stderr)
    return 0


def cmd_resolve(args):
    manifest, errs = load_manifest(args.manifest)
    if errs:
        for e in errs:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    errors = validate_manifest(manifest)
    if errors:
        for e in errors:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    lock, lock_errs = load_lock(args.lock)
    if lock_errs:
        for e in lock_errs:
            print("ERROR: %s" % e, file=sys.stderr)
        return 1
    idx = _lock_index(lock)
    resolved = []
    for p in manifest.get("packages", []):
        name = p["name"]
        if name in idx and not args.force:
            resolved.append(idx[name])
            continue
        # pick exactly one winner: preferred, else first listed
        winner = p.get("preferred") or p["providers"][0]
        if winner not in p["providers"]:
            print("ERROR: %s: winner %r not in providers (refusing to mix)" % (name, winner),
                  file=sys.stderr)
            return 1
        entry = {"name": name, "provider": winner,
                 "version": _wanted_version(p.get("wanted", ""))}
        if p.get("package"):
            entry["package"] = p["package"]
        if p.get("env_var"):
            entry["env_var"] = p["env_var"]
        if winner == "custom-url":
            entry["sha256"] = p.get("sha256", "")
        if winner == "fetchcontent":
            entry["repo"] = p.get("repo", "")
            entry["ref"] = p.get("ref", "")
        resolved.append(entry)
    lock["schema_version"] = 1
    lock["resolved"] = resolved
    with open(args.lock, "w", encoding="ascii", newline="\n") as h:
        h.write(dump_simple_yaml(lock) + "\n")
    print("coldpac resolve ok: %d entries -> %s" % (len(resolved), args.lock))
    return 0


def _wanted_version(spec):
    m = re.search(r"([vV]?\d[\w.\-+~]*)", str(spec))
    return m.group(1) if m else str(spec)


def build_parser():
    ap = argparse.ArgumentParser(prog="coldpac",
                                 description="manager of package managers")
    ap.add_argument("--version", action="version", version="coldpac " + VERSION)
    ap.add_argument("--manifest", default="deps.yaml")
    ap.add_argument("--lock", default="deps.lock")
    ap.add_argument("--offline", action="store_true",
                    help="perform zero network calls")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("validate")
    sub.add_parser("status")
    sub.add_parser("check-updates")
    pe = sub.add_parser("export")
    pe.add_argument("--out", default="versions.env")
    pi = sub.add_parser("import")
    pi.add_argument("--env", default="versions.env")
    pi.add_argument("--out", default="")
    pr = sub.add_parser("resolve")
    pr.add_argument("--force", action="store_true",
                    help="re-resolve even locked entries")
    return ap


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.cmd == "validate":
        return cmd_validate(args)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "check-updates":
        return cmd_check_updates(args)
    if args.cmd == "export":
        return cmd_export(args)
    if args.cmd == "import":
        return cmd_import(args)
    if args.cmd == "resolve":
        return cmd_resolve(args)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
